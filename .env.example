# Recommended default for Docker-based development: PostgreSQL via Docker
USE_SQLITE=0

# PostgreSQL
POSTGRES_DB=trello
POSTGRES_USER=trello
POSTGRES_PASSWORD=change-me
DATABASE_HOST=db
DATABASE_PORT=5432

# Django (local dev)
DJANGO_SECRET_KEY=replace-me-with-secure-key
DJANGO_DEBUG=1
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Production deployment variables (Render / cloud)
# DATABASE_URL=postgresql://user:password@host:5432/database
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain.onrender.com,http://localhost:3000
# CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.onrender.com
# RENDER_EXTERNAL_URL=https://your-backend-domain.onrender.com

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# Optional fallback for local non-Docker development:
# USE_SQLITE=1
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
